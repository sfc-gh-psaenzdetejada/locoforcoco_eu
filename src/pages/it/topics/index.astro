---
import { getCollection } from "astro:content";
import PageIntro from "@/components/PageIntro.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import TopicChip from "@/components/TopicChip.astro";
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getTopicMeta } from "@/config/topics";
import { localePath } from "@/config/i18n";
import { byTopic, formatDate, publishedIssues, topicSlug, topics } from "@/lib/issues";

const locale = "it";
const issues = publishedIssues(await getCollection("issues"), locale);
const rows = topics
  .map((topic) => ({ topic, issues: byTopic(issues, topic) }))
  .filter((row) => row.issues.length > 0);
---

<BaseLayout title="Categorie" description="Categorie dei video CoCo.">
  <SiteHeader />
  <main id="content">
    <div class="container">
      <PageIntro
        title="Categorie"
        description="Tutto quello che trattiamo, organizzato per argomento."
        note={`${rows.length} categorie · ${issues.length} video`}
      />
    </div>

    <section class="container section--tight" aria-label="Categorie">
      <div class="topic-list">
        {
          rows.map(({ topic, issues: list }) => (
            <a class="topic-row" href={localePath(locale, `/topics/${topicSlug(topic)}/`)}>
              <div class="stack" style="gap:0.6rem">
                <TopicChip topic={topic} linked={false} />
                <p class="t-h3">{getTopicMeta(topic, locale).summary}</p>
                <p class="t-meta">
                  {list.length} {list.length === 1 ? "video" : "video"} · Ultimo{" "}
                  {formatDate(list[0].data.date, "short", locale)}
                </p>
              </div>
              <Icon name="arrow-right" size={18} class="topic-row__arrow" />
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .topic-list { display: grid; }
  .topic-row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1.5rem; border-top: 1px solid var(--line); padding: 1.75rem 0.75rem;
    margin-inline: -0.75rem; transition: background-color var(--speed) var(--ease);
  }
  .topic-row:last-child { border-bottom: 1px solid var(--line); }
  .topic-row:hover { background: var(--surface); }
  .topic-row:hover .t-h3 { color: var(--accent); }
  .topic-row__arrow { flex: none; color: var(--ink-faint); }
  .topic-row:hover .topic-row__arrow { color: var(--accent); }
</style>
