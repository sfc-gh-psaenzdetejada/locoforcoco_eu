---
import { getCollection } from "astro:content";
import PageIntro from "@/components/PageIntro.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Avatar from "@/components/ui/Avatar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { writerBio } from "@/config/writers";
import { allWriters, formatDate, publishedIssues, writerSlug } from "@/lib/issues";

const issues = publishedIssues(await getCollection("issues"), "en");
const editor = allWriters(issues).find((writer) => writer.name === siteConfig.editor.name);
const first = issues.at(-1);
---

<BaseLayout title="About" description={`What ${siteConfig.name} is, who makes it, and why.`}>
  <SiteHeader />
  <main id="content">
    <div class="container">
      <PageIntro
        title={`About ${siteConfig.name}`}
        description="Short, focused video demos of Snowflake Cortex Code."
        note={first ? `Publishing since ${formatDate(first.data.date, "long", "en")}` : undefined}
      />
    </div>

    <section class="reading section">
      <div class="prose">
        <h2>What is this</h2>
        <p>
          {siteConfig.name} is a collection of short videos showing what you can do with
          Cortex Code (CoCo), Snowflake's AI-powered IDE. Each video focuses on a single
          task — a query, an AI function, a cost analysis, a security policy — and walks
          through it step by step.
        </p>
        <p>
          Videos are organized by category (Engineering, AI, FinOps, Governance...)
          so you can quickly find what you need.
        </p>

        <h2>Who is it for</h2>
        <ul>
          <li>Data Engineers and analysts who want to learn CoCo hands-on.</li>
          <li>Solutions Engineers looking for quick demos to share with customers.</li>
          <li>Anyone curious about what Snowflake can do with AI.</li>
        </ul>

        <h2>Who makes it</h2>
        <p>
          This site is maintained by Pablo Saenz de Tejada, Solutions Engineer at Snowflake.
          The videos show real workflows with CoCo.
        </p>
      </div>
    </section>

    {
      editor && (
        <section class="reading section--tight" aria-labelledby="editor-title">
          <h2 class="t-h3" id="editor-title" style="margin-bottom:1.25rem">
            {siteConfig.editor.title}
          </h2>
          <a class="writer-card" href={`/en/writers/${writerSlug(editor.name)}/`}>
            <Avatar name={editor.name} size="lg" />
            <span class="stack" style="gap:0.3rem">
              <span class="t-h4">{editor.name}</span>
              <span class="t-meta">{editor.role}</span>
              <span class="t-small t-dim" style="margin-top:0.35rem">{writerBio(editor.name)}</span>
            </span>
          </a>
        </section>
      )
    }

    <section class="reading section--tight">
      <p class="t-body t-dim">
        Questions or suggestions? Write to{" "}
        <a class="link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
      </p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
