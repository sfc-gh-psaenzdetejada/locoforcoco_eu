---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import IssueCard from "@/components/IssueCard.astro";
import IssueIndex from "@/components/IssueIndex.astro";
import IssueMeta from "@/components/IssueMeta.astro";
import SectionHead from "@/components/SectionHead.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import TopicChip from "@/components/TopicChip.astro";
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getTopicMeta } from "@/config/topics";
import { t } from "@/config/i18n";
import {
  byTopic,
  issueHref,
  issueNumber,
  leadIssue,
  publishedIssues,
  topics,
  formatDate,
} from "@/lib/issues";

const locale = "en";
const issues = publishedIssues(await getCollection("issues"), locale);

const lead = leadIssue(issues);
const rest = issues.filter((issue) => issue.id !== lead?.id);
const leadIsNewest = lead?.id === issues[0]?.id;
const recent = rest.slice(0, 2);
const ledger = rest.slice(2, 9);

const topicCounts = topics
  .map((topic) => ({ topic, count: byTopic(issues, topic).length }))
  .filter((entry) => entry.count > 0);
---

<BaseLayout>
  <SiteHeader />

  <main id="content">
    <section class="container" aria-labelledby="masthead-title">
      <div class="masthead">
        <h1 class="t-display" id="masthead-title">{t(locale, "site.tagline")}.</h1>
        <p class="t-lead">{t(locale, "site.bio")}</p>
        <p class="meta masthead__facts">
          <span>{issues.length} videos</span>
          <span class="dot-sep" aria-hidden="true"></span>
          <a class="link" href="/en/archive/">{t(locale, "issue.allIssues")}</a>
        </p>
      </div>
    </section>

    {
      lead && (
        <section class="container" aria-labelledby="lead-title">
          <a class="lead" href={issueHref(lead, locale)}>
            <div class="lead__media">
              <Image
                src={lead.data.cover.src}
                alt={lead.data.cover.alt}
                widths={[480, 720, 1080]}
                sizes="(min-width: 56rem) 34rem, 92vw"
                loading="eager"
                fetchpriority="high"
              />
            </div>

            <div class="lead__body">
              <p class="meta">
                <span class="chip chip--current">
                  {leadIsNewest ? t(locale, "issue.latest") : t(locale, "issue.featured")}
                </span>
                <span class="t-number">{t(locale, "issue.no")} {issueNumber(lead)}</span>
                <span class="dot-sep" aria-hidden="true" />
                <span>{formatDate(lead.data.date, "short", locale)}</span>
              </p>

              <h2 class="t-h1" id="lead-title">{lead.data.title}</h2>
              <p class="t-lead">{lead.data.excerpt}</p>

              <IssueMeta issue={lead} showWriter />

              <span class="arrow-link">
                {t(locale, "issue.readThis")}
                <Icon name="arrow-right" size={15} />
              </span>
            </div>
          </a>
        </section>
      )
    }

    {
      recent.length > 0 && (
        <section class="container section" aria-labelledby="recent-title">
          <SectionHead title={t(locale, "issue.alsoRecently")} id="recent-title" href="/en/archive/" linkLabel={t(locale, "issue.allIssues")} />
          <div class="cards cards--2">
            {recent.map((issue) => (
              <IssueCard issue={issue} headingLevel="h3" />
            ))}
          </div>
        </section>
      )
    }

    {
      ledger.length > 0 && (
        <section class="container section--tight" aria-labelledby="ledger-title">
          <SectionHead
            title={t(locale, "issue.backIssues")}
            id="ledger-title"
            href="/en/archive/"
            linkLabel={t(locale, "issue.fullArchive")}
          />
          <IssueIndex issues={ledger} />
        </section>
      )
    }

    <section class="container section" aria-labelledby="topics-title">
      <SectionHead title={t(locale, "issue.readByTopic")} id="topics-title" href="/en/topics/" />
      <div class="topic-grid">
        {
          topicCounts.map(({ topic, count }) => (
            <div class="topic-tile">
              <TopicChip topic={topic} count={count} />
              <p class="t-small t-dim">{getTopicMeta(topic, locale).summary}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .topic-grid {
    display: grid;
    gap: 1.5rem;
  }

  .topic-tile {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  @media (min-width: 40rem) {
    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 2.5rem;
    }
  }

  @media (min-width: 68rem) {
    .topic-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
