---
import { getLocaleFromUrl, defaultLocale, localePath, locales } from "@/config/i18n";

const locale = getLocaleFromUrl(Astro.url);

// Strip locale prefix to get the bare path
let barePath = Astro.url.pathname;
if (locale !== defaultLocale) {
  barePath = barePath.replace(new RegExp(`^/${locale}`), "") || "/";
}

const langNames: Record<string, string> = { es: "ES", en: "EN", it: "IT" };
const otherLocales = locales.filter((l) => l !== locale);
---

<div class="lang-switcher">
  <span class="lang-current">{langNames[locale]}</span>
  {otherLocales.map((l) => (
    <a class="lang-switch" href={localePath(l, barePath)}>
      {langNames[l]}
    </a>
  ))}
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .lang-current {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--accent);
    padding: 0.2rem 0.35rem;
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm, 0.25rem);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    text-decoration: none;
    transition: all var(--speed, 0.15s) var(--ease, ease);
  }
  .lang-switch:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
