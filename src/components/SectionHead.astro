---
import Icon from "@/components/ui/Icon.astro";
import { getLocaleFromUrl } from "@/config/i18n";

interface Props {
  title: string;
  id?: string;
  note?: string;
  href?: string;
  linkLabel?: string;
  headingLevel?: "h2" | "h3";
}

const locale = getLocaleFromUrl(Astro.url);
const defaultLabel = { es: "Ver todas", en: "See all", it: "Vedi tutto" }[locale] ?? "See all";
const { title, id, note, href, linkLabel = defaultLabel, headingLevel: Heading = "h2" } = Astro.props;
---

<div class="head">
  <div>
    <Heading class="t-h2" id={id}>{title}</Heading>
    {note && <p class="t-meta" style="margin-top:0.4rem">{note}</p>}
  </div>

  {
    href && (
      <a class="arrow-link" href={href}>
        {linkLabel}
        <Icon name="arrow-right" size={15} />
      </a>
    )
  }
</div>
