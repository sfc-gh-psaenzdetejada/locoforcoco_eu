---
import Icon from "@/components/ui/Icon.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import SearchRuntime from "@/components/SearchRuntime.astro";
import SiteDrawer from "@/components/SiteDrawer.astro";
import { primaryNavigation, siteConfig } from "@/config/site";
import { getLocaleFromUrl, localePath } from "@/config/i18n";

const locale = getLocaleFromUrl(Astro.url);
const nav = primaryNavigation(locale);
const searchLabel = { es: 'Buscar videos', en: 'Search videos', it: 'Cerca video' }[locale];
const menuLabel = { es: 'Abrir menu', en: 'Toggle menu', it: 'Apri menu' }[locale];
const searchPlaceholder = { es: 'Buscar videos...', en: 'Search videos...', it: 'Cerca video...' }[locale];
const closeLabel = { es: 'Cerrar busqueda', en: 'Close search', it: 'Chiudi ricerca' }[locale];
const searchHint = { es: 'Escribe para buscar en el archivo.', en: 'Type to search the archive.', it: 'Scrivi per cercare nell\'archivio.' }[locale];

/**
 * Wordmark, the routes that matter, search, colour mode, and the signup
 * button. Everything else lives in the footer, which is what lets the bar look
 * the same at 360px as it does at 1600px. Below the nav breakpoint the routes
 * move into `SiteDrawer`.
 */
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="wordmark" href={localePath(locale, "/")} aria-label={`${siteConfig.name} home`}>
      {siteConfig.name}
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button type="button" class="header-search" data-search-open>
        <Icon name="search" size={15} />
        <span>{searchLabel}</span>
        <kbd aria-hidden="true">/</kbd>
      </button>

      <button
        type="button"
        class="icon-btn header-search-icon"
        aria-label={searchLabel}
        data-search-open
      >
        <Icon name="search" size={18} />
      </button>

      <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch colour theme">
        <Icon name="sun" size={18} class="theme-sun" />
        <Icon name="moon" size={18} class="theme-moon" />
      </button>

      <LanguageSwitcher />



      <button
        type="button"
        class="icon-btn menu-btn"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-drawer-open
      >
        <Icon name="menu" size={20} class="menu-open" />
        <Icon name="close" size={20} class="menu-close" />
        <span class="sr-only">{menuLabel}</span>
      </button>
    </div>
  </div>
</header>

<SiteDrawer />

<dialog class="search-dialog" data-search-dialog data-locale={locale} aria-label={`${searchLabel} - ${siteConfig.name}`}>
  <form class="search-field" action={localePath(locale, "/search/")} method="get" role="search">
    <Icon name="search" size={19} class="t-faint" />
    <label class="sr-only" for="site-search">{searchLabel}</label>
    <input
      id="site-search"
      name="q"
      type="search"
      placeholder={searchPlaceholder}
      autocomplete="off"
      enterkeyhint="search"
      data-search-input
    />
    <button type="button" class="icon-btn" aria-label={closeLabel} data-search-close>
      <Icon name="close" size={18} />
    </button>
  </form>
  <p class="search-status" aria-live="polite" data-search-status>{searchHint}</p>
  <div class="search-results" data-search-results></div>
</dialog>

<SearchRuntime />

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  /* The bar only grows a rule once the page has moved under it, and it only
     hides once the page has scrolled past it — so a short page, or a rubber
     band at the top, never makes it flicker. */
  let lastY = window.scrollY;

  const onScroll = () => {
    if (!header) return;
    const y = window.scrollY;
    const past = y > header.offsetHeight;
    /* An open drawer or dialog owns the viewport; moving the bar under it
       would be motion nobody asked for. */
    const modal = document.documentElement.classList.contains("has-open-menu");

    header.classList.toggle("is-stuck", y > 4);
    header.classList.toggle("is-hidden", past && !modal && y > lastY);
    lastY = y;
  };

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
  const input = dialog?.querySelector<HTMLInputElement>("[data-search-input]");
  const results = dialog?.querySelector<HTMLElement>("[data-search-results]");
  const status = dialog?.querySelector<HTMLElement>("[data-search-status]");
  const loc = dialog?.dataset.locale ?? "es";

  const render = async () => {
    const runtime = window.mailerSearch;
    if (!input || !results || !status || !runtime) return;

    const query = input.value.trim();
    if (!query) {
      const items = await runtime.load();
      const n = items.length;
      status.textContent = loc === "es" ? `Buscar entre ${n} videos por titulo, categoria o autor.`
        : loc === "it" ? `Cerca tra ${n} video per titolo, categoria o autore.`
        : `Search ${n} videos by title, topic, or writer.`;
      results.innerHTML = "";
      return;
    }

    const matches = (await runtime.search(query)).slice(0, 8);
    if (input.value.trim() !== query) return;

    const n = matches.length;
    status.textContent = loc === "es" ? `${n} ${n === 1 ? "resultado" : "resultados"} para "${query}".`
      : loc === "it" ? `${n} ${n === 1 ? "risultato" : "risultati"} per "${query}".`
      : `${n} ${n === 1 ? "result" : "results"} for "${query}".`;
    results.innerHTML = matches.map(runtime.resultMarkup).join("");
  };

  const open = () => {
    if (!dialog?.showModal || dialog.open) return;
    dialog.showModal();
    void render();
    window.requestAnimationFrame(() => input?.focus());
  };

  document.querySelectorAll("[data-search-open]").forEach((button) => {
    button.addEventListener("click", open);
  });

  dialog?.querySelector("[data-search-close]")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  input?.addEventListener("input", () => void render());

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    const editing =
      target instanceof HTMLElement &&
      (target.matches("input, textarea, select") || target.isContentEditable);
    const command = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
    const slash = event.key === "/" && !editing && !event.metaKey && !event.ctrlKey && !event.altKey;
    if (!command && !slash) return;

    event.preventDefault();
    if (dialog?.open) dialog.close();
    else open();
  });
</script>

